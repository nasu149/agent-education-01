# Gemini Developer API key.
GEMINI_API_KEY=replace_me

# Keep the model configurable because Gemini model availability changes over time.
# gemini-2.5-flash is a conservative default for the training material.
GEMINI_MODEL=gemini-2.5-flash

# Docker Compose project name. The MCP server only inspects containers in this project.
COMPOSE_PROJECT_NAME=agent-education

# Health monitoring.
HEALTH_CHECK_INTERVAL_SECONDS=5
MONITOR_STARTUP_GRACE_SECONDS=20
FAILURE_THRESHOLD=2

# Agent safety / behavior.
MAX_INVESTIGATION_TOOL_RESULTS=6
VERIFY_RETRY_LIMIT=1
LOG_LEVEL=INFO
