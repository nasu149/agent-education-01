# Gemini Developer API key.
GEMINI_API_KEY=replace_me

# Keep the model configurable because Gemini model availability changes over time.
# gemini-3.5-flash-lite is the current lightweight default for the training material.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini API request timeout in seconds.
# Free-tier / shared API capacity can occasionally be slow, so keep this generous
# for the training environment.
GEMINI_TIMEOUT_SECONDS=90

# Docker Compose project name. The MCP server first checks these labels and then
# falls back to explicit container names for the plain `docker run` training flow.
COMPOSE_PROJECT_NAME=agent-education

# Health monitoring.
# NOTE: This controls GET /api/members by the Agent health checker.
# The Dashboard separately calls GET /api/status about every 1.5 seconds only
# to refresh the screen; those requests are NOT health checks.
HEALTH_CHECK_INTERVAL_SECONDS=5
MONITOR_STARTUP_GRACE_SECONDS=20
FAILURE_THRESHOLD=2

# Agent safety / behavior.
# The connection-exhaustion scenario may require HTTP, container status, logs,
# and PostgreSQL connection observations before the model can conclude.
MAX_INVESTIGATION_TOOL_RESULTS=8
VERIFY_RETRY_LIMIT=1

# LangGraph-native console tracing.
# updates: print each node's partial State update (recommended for training)
# values:  print the full State after each step
# debug:   print very detailed checkpoint/task events
# off:     disable LangGraph console printing
LANGGRAPH_PRINT_MODE=updates

LOG_LEVEL=INFO


# Optional disk-full training scenario.
# pure_docker_up.sh / prepare_disk_full_training.sh attach this bounded tmpfs
# to Tomcat at /training-disk.
TRAINING_DISK_SIZE=16m
